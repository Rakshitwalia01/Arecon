# Set default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text diff=python
*.md text
*.json text
*.txt text
*.yml text
*.yaml text

# Bash scripts must always have LF line endings to execute properly on Unix
*.sh text eol=lf

# Windows Batch scripts must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
